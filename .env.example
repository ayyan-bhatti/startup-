# Public URL of the site (no trailing slash). Used for canonical URLs, sitemap, robots and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be on a domain verified in Resend (e.g. "Core <hello@example.com>").
# For quick local testing you can use: Core <onboarding@resend.dev>
CONTACT_FROM_EMAIL="Core <hello@example.com>"

# Where new-enquiry notifications are delivered (all form fields + timestamp; reply-to = visitor).
# Separate multiple addresses with commas.
CONTACT_TO_EMAIL=abdullahfarooq61305@gmail.com
